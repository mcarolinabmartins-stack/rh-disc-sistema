# Copie este arquivo para ".env" e preencha com as credenciais do seu projeto Supabase
# (Project Settings -> API no painel do Supabase, ou automaticamente preenchido
# pelo Lovable quando você conecta o Supabase pela integração nativa).

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA-CHAVE-ANON-PUBLICA
